# 复制本文件为 .env 后修改

# 必填：要跟踪的 pump.fun 代币地址
TOKEN_MINT=

# 管理员密钥（至少 6 位）。设置后可在 App「设置」里添加公司钱包、修改分红比例、管理股东等
ADMIN_KEY=

# 服务端口
PORT=8787

# 私有 Solana RPC —— 强烈推荐（例如 Helius：https://mainnet.helius-rpc.com/?api-key=你的KEY）
# 不填则使用 Solana 官方公共节点：可用，但限速严格
RPC_URL=
# 可选：对应的 WebSocket 地址（不填则由 RPC_URL 自动推导）
RPC_WS_URL=

# 数据目录（成交历史、配置、密钥都在这里，不要提交到 git）
DATA_DIR=data

# 可选：App 对外的网址（写进 VK 链资产元数据的图标链接），例如 https://app.example.com
PUBLIC_ORIGIN=

# 可选：推送提醒的联系方式（mailto: 邮箱或网址），不填则用 App 的网址
PUSH_SUBJECT=

# 可选：VK 链节点的 RPC 地址（默认 http://127.0.0.1:8899）
VKCHAIN_RPC=
